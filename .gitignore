# Editors
.idea

# Composer
/vendor/

# WordPress core, installed by Composer
/web/wp/

# Generated by the Wodby image at runtime
/web/wp-config.php

# Plugins installed by Composer; to commit a plugin of your own, add an exception such as
# !/web/wp-content/plugins/my-plugin/
/web/wp-content/plugins/*
!/web/wp-content/plugins/.gitkeep

# Must-use plugins installed by Composer; single-file must-use plugins of your own are committed
/web/wp-content/mu-plugins/*/

# Themes installed by Composer; your own themes are committed
/web/wp-content/themes/twentytwentyfive/

# Runtime files
/web/wp-content/uploads/
/web/wp-content/upgrade/
/web/wp-content/cache/
